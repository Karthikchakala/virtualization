# ==============================================================================
# CC2 Virtualization Lab Credentials & Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure credentials and parameters for your local environment below.
# 3. NEVER commit '.env' to version control or expose its contents in logs.
#
# AUTHENTICATION PRECEDENCE:
# - The future transport layer supports both SSH key and password authentication.
# - Precedence is deterministic: SSH key is preferred if configured and exists.
# - Password authentication is used only when explicitly provided and no key is set.
# - Do NOT configure both unless intentional (SSH key will take precedence).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KVM / QEMU (Type-1 / Type-1-like Hardware Virtualization)
# ------------------------------------------------------------------------------
KVM_VM_NAME=ubuntu24.04
# Guest IP is dynamically discoverable via virsh domifaddr / dnsmasq leases.
# Leave empty to enable dynamic discovery, or specify fixed IP if desired:
KVM_SSH_HOST=
KVM_SSH_PORT=22
KVM_SSH_USER=
KVM_SSH_PASSWORD=
KVM_SSH_KEY_PATH=

# ------------------------------------------------------------------------------
# 2. Oracle VM VirtualBox (Type-2 Hosted Hypervisor)
# ------------------------------------------------------------------------------
VBOX_VM_NAME=Ubuntu-Server-VBox
# Default NAT port forwarding maps host 127.0.0.1:2222 -> guest port 22:
VBOX_SSH_HOST=127.0.0.1
VBOX_SSH_PORT=2222
VBOX_SSH_USER=
VBOX_SSH_PASSWORD=
VBOX_SSH_KEY_PATH=

# ------------------------------------------------------------------------------
# 3. Native LXC (Linux OS-Level Virtualization / Containerization)
# ------------------------------------------------------------------------------
LXC_CONTAINER_NAME=lxc-ubuntu
# LXC execution executes locally via 'lxc-attach -n <container>'.
# No SSH credentials or password required.

# ------------------------------------------------------------------------------
# 4. Benchmark & Execution Defaults
# ------------------------------------------------------------------------------
BENCHMARK_STABILIZATION_SEC=2
BENCHMARK_TIMEOUT_SEC=120
BENCHMARK_SSH_CONNECT_TIMEOUT_SEC=5
